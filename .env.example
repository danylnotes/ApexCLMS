# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://apex:CHANGE_ME@localhost:5432/apex_lms?schema=public"

# --- Application ---
APP_URL="http://localhost:3000"
# Session lifetime in hours (absolute) and idle timeout in minutes
SESSION_TTL_HOURS="12"
SESSION_IDLE_MINUTES="60"
# Set to "true" when served over HTTPS (secure cookies)
COOKIE_SECURE="false"

# --- Private file storage ---
# "local" stores files on a private server path (never under /public).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
MAX_UPLOAD_MB="10"

# --- Email ---
# "outbox" records messages in the email_outbox table and server log (development).
# "smtp" is a documented integration point — see docs/DEPLOYMENT.md.
EMAIL_PROVIDER="outbox"
EMAIL_FROM="learning@example.com"

# --- Corporate SSO (Microsoft Entra ID) — optional, not active unless configured ---
ENTRA_TENANT_ID=""
ENTRA_CLIENT_ID=""
ENTRA_CLIENT_SECRET=""

# --- Scheduled jobs ---
# Shared secret required by POST /api/v1/jobs/run (used by an external scheduler)
JOBS_SECRET=""

# Show the demonstration account list on the sign-in page (never enable with real users)
DEMO_MODE="false"
